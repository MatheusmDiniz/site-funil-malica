---
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="section final-cta" aria-labelledby="final-cta-title">
  <div class="container final-cta__inner">
    <h2 id="final-cta-title" class="final-cta__title">
      Não perca as próximas promoções 🧡
    </h2>
    <p class="final-cta__subtitle">
      Entre gratuitamente no nosso grupo e receba os achadinhos que encontramos
      todos os dias.
    </p>
    <WhatsAppCta label="Entrar no grupo VIP" variant="secondary" />
  </div>
</section>

<style>
  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: linear-gradient(
      180deg,
      var(--malica-bege) 0%,
      rgba(244, 215, 197, 0.4) 100%
    );
    border-radius: var(--malica-radius-lg);
    padding: clamp(2rem, 6vw, 2.75rem) clamp(1.25rem, 4vw, 2rem);
    border: 1px solid rgba(235, 168, 168, 0.35);
  }

  .final-cta__title {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    margin-bottom: 0.625rem;
    text-wrap: balance;
  }

  .final-cta__subtitle {
    font-size: 0.9375rem;
    color: var(--malica-text-muted);
    max-width: 22rem;
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }
</style>
