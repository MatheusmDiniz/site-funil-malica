---
import { SITE } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img
        src="/images/malica-logo.png"
        alt="Malica"
        width="100"
        height="28"
        loading="lazy"
        class="footer__logo"
      />
      <p class="footer__copyright">© {currentYear} Malica</p>
    </div>

    <nav class="footer__nav" aria-label="Links do rodapé">
      <a href="/politica-de-privacidade">Política de Privacidade</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <a href="/termos-de-uso">Termos de Uso</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <a href={`mailto:${SITE.contactEmail}`}>Contato</a>
    </nav>

    <div class="footer__legal">
      <p>
        Alguns links divulgados pela Malica podem ser links de afiliados. Ao comprar
        através deles, podemos receber uma comissão, sem nenhum custo adicional para
        você.
      </p>
      <p>
        Preços, disponibilidade e promoções podem mudar sem aviso prévio.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 2rem;
    border-top: 1px solid rgba(115, 77, 87, 0.08);
    background-color: var(--malica-creme-escuro);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__logo {
    width: auto;
    height: 1.75rem;
    opacity: 0.85;
  }

  .footer__copyright {
    font-size: 0.8125rem;
    color: var(--malica-text-muted);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.375rem 0.5rem;
    font-size: 0.875rem;
  }

  .footer__nav a {
    color: var(--malica-marrom-ameixa);
    text-decoration: none;
    padding: 0.25rem 0.125rem;
  }

  .footer__nav a:hover {
    text-decoration: underline;
  }

  .footer__sep {
    color: var(--malica-text-muted);
    user-select: none;
  }

  .footer__legal {
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__legal p {
    font-size: 0.75rem;
    color: var(--malica-text-muted);
    line-height: 1.55;
  }
</style>
