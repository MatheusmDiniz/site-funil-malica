<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner fade-in">
    <h1 id="hero-title" class="hero__title">
      Achadinhos para mamães e bebês 💚
    </h1>
    <p class="hero__subtitle">
      Ofertas encontradas pela Malica ao longo do dia.
    </p>
    <p class="hero__badge">Atualizado ao longo do dia</p>
  </div>
</section>

<style>
  .hero {
    padding-top: 0;
    padding-bottom: 0.35rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 26rem;
    margin-inline: auto;
  }

  .hero__title {
    font-size: clamp(1.2rem, 4.8vw, 1.5rem);
    color: var(--malica-marrom-ameixa);
    margin-bottom: 0.2rem;
    text-wrap: balance;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero__subtitle {
    font-size: 0.8125rem;
    color: var(--malica-text-muted);
    line-height: 1.4;
    margin-bottom: 0.4rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #5f7f72;
    background: rgba(139, 170, 157, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
</style>
