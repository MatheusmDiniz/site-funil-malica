---
import { LANDING_COPY } from '../config/site';
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__layout">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">{LANDING_COPY.heroHeadline}</h1>
      <p class="hero__signature">{LANDING_COPY.heroSignature}</p>

      <div class="hero__cta">
        <WhatsAppCta
          label={LANDING_COPY.ctaHero}
          ctaPosition="hero"
          heroAnchor
        />
      </div>

      <p class="hero__trust">{LANDING_COPY.trustMicrocopy}</p>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__phone" data-hero-mockup>
        <img
          class="hero__mascot"
          src="/images/malica-mascote.png"
          alt=""
          width="160"
          height="160"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__phone-notch"></div>
        <div class="hero__phone-screen">
          <p class="hero__chat-header">Malica</p>

          <!-- Slot 1: estável em altura — brand ou oferta real -->
          <div class="hero__slot" data-hero-slot="0">
            <div class="hero__bubble hero__bubble--brand" data-slot-brand>
              <span class="hero__bubble-label">Malica</span>
              <p>Achadinho encontrado</p>
              <p class="hero__bubble-meta">Oferta no grupo</p>
            </div>
            <div class="hero__bubble hero__bubble--offer" data-slot-offer hidden>
              <div class="hero__bubble-row">
                <img
                  class="hero__bubble-img"
                  data-mockup-img
                  src="/images/malica-mascote.png"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <p class="hero__bubble-name" data-mockup-name></p>
                  <p class="hero__bubble-price" data-mockup-price></p>
                </div>
              </div>
              <p class="hero__bubble-meta">Oferta encontrada pela Malica</p>
            </div>
          </div>

          <!-- Slot 2: estável -->
          <div class="hero__slot" data-hero-slot="1">
            <div class="hero__bubble hero__bubble--brand" data-slot-brand>
              <span class="hero__bubble-label">Malica</span>
              <p>Novas promoções ao longo do dia</p>
              <p class="hero__bubble-meta">Direto no WhatsApp</p>
            </div>
            <div class="hero__bubble hero__bubble--offer" data-slot-offer hidden>
              <div class="hero__bubble-row">
                <img
                  class="hero__bubble-img"
                  data-mockup-img
                  src="/images/malica-mascote.png"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <p class="hero__bubble-name" data-mockup-name></p>
                  <p class="hero__bubble-price" data-mockup-price></p>
                </div>
              </div>
              <p class="hero__bubble-meta">Oferta encontrada pela Malica</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    getHeroMockupOffers,
    presentOfferTitle,
    whenOffersReady,
  } from '../scripts/offers-feed.ts';

  function formatBRL(value: number): string {
    return value.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL',
    });
  }

  function enrichHeroMockup(): void {
    const offers = getHeroMockupOffers(2);
    if (offers.length === 0) return;

    offers.forEach((offer, i) => {
      const slot = document.querySelector<HTMLElement>(`[data-hero-slot="${i}"]`);
      if (!slot) return;
      const brand = slot.querySelector<HTMLElement>('[data-slot-brand]');
      const bubble = slot.querySelector<HTMLElement>('[data-slot-offer]');
      const name = bubble?.querySelector<HTMLElement>('[data-mockup-name]');
      const price = bubble?.querySelector<HTMLElement>('[data-mockup-price]');
      const img = bubble?.querySelector<HTMLImageElement>('[data-mockup-img]');
      if (!bubble || !name || !price || !brand) return;

      name.textContent = presentOfferTitle(offer.titulo, 42);
      price.textContent = `De ${formatBRL(offer.preco_anterior!)} por ${formatBRL(offer.preco!)}`;

      if (img && offer.imagem?.trim()) {
        img.src = offer.imagem.trim();
        img.onerror = () => {
          img.onerror = null;
          img.src = '/images/malica-mascote.png';
        };
      }

      brand.setAttribute('hidden', '');
      bubble.removeAttribute('hidden');
    });
  }

  whenOffersReady(enrichHeroMockup);
</script>

<style>
  .hero {
    padding-block: 0.5rem 0.85rem;
    background: linear-gradient(
      180deg,
      rgba(244, 215, 197, 0.35) 0%,
      rgba(255, 248, 245, 0) 72%
    );
  }

  .hero__layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 28rem;
    width: 100%;
    gap: 0;
  }

  .hero__title {
    font-size: clamp(1.45rem, 5.5vw, 1.85rem);
    color: var(--malica-marrom-ameixa);
    margin-bottom: 0.65rem;
    text-wrap: balance;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero__signature {
    font-family: var(--malica-font-body);
    font-size: clamp(0.875rem, 3vw, 0.9375rem);
    font-weight: 500;
    color: var(--malica-text-muted);
    margin-bottom: 1rem;
    line-height: 1.45;
    text-wrap: balance;
  }

  .hero__cta {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .hero__cta :global(.whatsapp-cta) {
    max-width: 22rem;
    min-height: 3.25rem;
    font-size: 1.0625rem;
  }

  .hero__trust {
    font-size: 0.7rem;
    color: var(--malica-text-muted);
    line-height: 1.35;
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 359px) {
    .hero__trust {
      font-size: 0.625rem;
      letter-spacing: -0.01em;
    }
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 22.5rem;
  }

  .hero__phone {
    position: relative;
    width: 100%;
    border-radius: 1.5rem;
    background: linear-gradient(
      165deg,
      var(--malica-bege) 0%,
      rgba(244, 215, 197, 0.45) 100%
    );
    border: 1px solid rgba(115, 77, 87, 0.1);
    box-shadow: var(--malica-shadow-md);
    padding: 0.65rem 0.65rem 0.85rem;
  }

  .hero__mascot {
    position: absolute;
    top: -1.35rem;
    right: -0.35rem;
    width: 5.75rem;
    height: 5.75rem;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
  }

  .hero__phone-notch {
    width: 3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: rgba(115, 77, 87, 0.18);
    margin: 0.2rem auto 0.55rem;
  }

  .hero__phone-screen {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--malica-surface);
    border-radius: 1rem;
    padding: 0.75rem 0.7rem 0.85rem;
    min-height: 14.5rem;
  }

  .hero__chat-header {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--malica-marrom-ameixa);
    text-align: center;
    margin-bottom: 0.1rem;
  }

  .hero__slot {
    min-height: 4.75rem;
  }

  .hero__bubble {
    background: rgba(139, 170, 157, 0.14);
    border-radius: 0.75rem 0.75rem 0.75rem 0.25rem;
    padding: 0.55rem 0.65rem;
    text-align: left;
    min-height: 4.5rem;
    box-sizing: border-box;
  }

  .hero__bubble[hidden] {
    display: none !important;
  }

  .hero__bubble-label {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    color: #5f7f72;
    margin-bottom: 0.15rem;
  }

  .hero__bubble p {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--malica-marrom-ameixa);
  }

  .hero__bubble-meta {
    margin-top: 0.2rem !important;
    font-size: 0.625rem !important;
    color: var(--malica-text-muted) !important;
  }

  .hero__bubble-row {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .hero__bubble-img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    border-radius: 0.4rem;
    background: #fff;
    flex-shrink: 0;
  }

  .hero__bubble-name {
    font-weight: 600;
    font-size: 0.6875rem !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 1.85em;
  }

  .hero__bubble-price {
    font-weight: 700;
    font-size: 0.75rem !important;
    color: #5f7f72 !important;
    margin-top: 0.15rem !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__copy {
      animation: heroCopyIn 0.35s ease-out both;
    }

    .hero__visual {
      animation: heroVisualIn 0.4s ease-out 0.08s both;
    }

    .hero__mascot {
      animation: heroMascotIn 0.45s ease-out 0.12s both;
    }

    .hero__slot:nth-child(2) {
      animation: heroBubbleIn 0.3s ease-out 0.18s both;
    }

    .hero__slot:nth-child(3) {
      animation: heroBubbleIn 0.3s ease-out 0.28s both;
    }
  }

  @keyframes heroCopyIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroVisualIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroMascotIn {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes heroBubbleIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 1.15rem 1.35rem;
    }

    .hero__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 2rem 2.5rem;
      width: 100%;
    }

    .hero__copy {
      align-items: flex-start;
      text-align: left;
      max-width: none;
      width: 100%;
    }

    .hero__cta {
      justify-content: flex-start;
    }

    .hero__cta :global(.whatsapp-cta) {
      max-width: 20rem;
    }

    .hero__visual {
      width: 100%;
      max-width: 26.25rem;
      justify-self: end;
    }

    .hero__phone {
      max-width: 25rem;
      width: 100%;
      margin-inline: auto 0;
    }

    .hero__mascot {
      width: 7rem;
      height: 7rem;
      top: -1.65rem;
      right: -0.65rem;
    }

    .hero__phone-screen {
      min-height: 16rem;
    }

    .hero__title {
      font-size: clamp(1.85rem, 2.6vw, 2.35rem);
      margin-bottom: 0.75rem;
    }

    .hero__signature {
      font-size: 1rem;
      margin-bottom: 1.15rem;
    }
  }
</style>
