---
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content fade-in">
      <h1 id="hero-title" class="hero__title">
        As melhores ofertas para seu bebê, todos os dias
      </h1>
      <p class="hero__subtitle">
        Receba promoções, cupons e achadinhos de lojas confiáveis direto no nosso
        grupo gratuito.
      </p>

      <div class="hero__cta">
        <WhatsAppCta />
      </div>

      <ul class="hero__benefits" aria-label="Benefícios do grupo">
        <li class="hero__benefit">
          <svg class="hero__check" viewBox="0 0 20 20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            ></path>
          </svg>
          100% gratuito
        </li>
        <li class="hero__benefit">
          <svg class="hero__check" viewBox="0 0 20 20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            ></path>
          </svg>
          Ofertas todos os dias
        </li>
        <li class="hero__benefit">
          <svg class="hero__check" viewBox="0 0 20 20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            ></path>
          </svg>
          Cupons e promoções
        </li>
      </ul>
    </div>

    <div class="hero__visual fade-in">
      <img
        src="/images/malica-mascote.png"
        alt="Mascote Malica — capivara dentro de uma sacola de compras"
        width="280"
        height="280"
        fetchpriority="high"
        class="hero__mascot"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 0.5rem;
    padding-bottom: var(--malica-section-gap);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 28rem;
  }

  .hero__title {
    font-size: clamp(1.625rem, 5.5vw, 2.25rem);
    color: var(--malica-marrom-ameixa);
    margin-bottom: 1rem;
  }

  .hero__subtitle {
    font-size: clamp(0.9375rem, 2.8vw, 1.0625rem);
    color: var(--malica-text-muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .hero__cta {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .hero__benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }

  .hero__benefit {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--malica-text-muted);
  }

  .hero__check {
    width: 1rem;
    height: 1rem;
    color: var(--malica-verde-salvia);
    flex-shrink: 0;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__mascot {
    width: min(220px, 65vw);
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .hero__inner {
      flex-direction: row-reverse;
      text-align: left;
      justify-content: center;
      gap: 3rem;
    }

    .hero__content {
      align-items: flex-start;
      flex: 1;
      max-width: 24rem;
    }

    .hero__cta {
      justify-content: flex-start;
    }

    .hero__benefits {
      justify-content: flex-start;
    }

    .hero__mascot {
      width: 260px;
    }
  }
</style>
