---
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content fade-in">
      <h1 id="hero-title" class="hero__title">
        Pague menos nos itens do seu bebê 🍼
      </h1>
      <p class="hero__subtitle">
        Encontramos promoções, cupons e achadinhos para mamães e bebês e enviamos
        tudo no nosso Grupo VIP gratuito.
      </p>

      <div class="hero__cta">
        <WhatsAppCta label="Entrar grátis no grupo VIP 🧡" />
      </div>

      <p class="hero__trust">
        🔕 Só administradores enviam mensagens · 🆓 100% gratuito
      </p>
    </div>

    <div class="hero__visual fade-in">
      <img
        src="/images/malica-mascote.png"
        alt="Mascote Malica — capivara dentro de uma sacola de compras"
        width="280"
        height="280"
        fetchpriority="high"
        class="hero__mascot"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 0.5rem;
    padding-bottom: var(--malica-section-gap);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 28rem;
  }

  .hero__title {
    font-size: clamp(1.5rem, 5.5vw, 2.125rem);
    color: var(--malica-marrom-ameixa);
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .hero__subtitle {
    font-size: clamp(0.9375rem, 2.8vw, 1.0625rem);
    color: var(--malica-text-muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .hero__cta {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 0.875rem;
  }

  .hero__trust {
    font-size: 0.8125rem;
    color: var(--malica-text-muted);
    line-height: 1.5;
    max-width: 22rem;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__mascot {
    width: min(200px, 55vw);
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .hero__inner {
      flex-direction: row-reverse;
      text-align: left;
      justify-content: center;
      gap: 3rem;
    }

    .hero__content {
      align-items: flex-start;
      flex: 1;
      max-width: 26rem;
    }

    .hero__cta {
      justify-content: flex-start;
    }

    .hero__trust {
      text-align: left;
    }

    .hero__mascot {
      width: 240px;
    }
  }
</style>
