---
import { LANDING_COPY, HOW_IT_WORKS } from '../config/site';

const flow = HOW_IT_WORKS.map((item, index) => ({
  ...item,
  icon: index === 0 ? 'search' : index === 1 ? 'heart' : 'phone',
}));
---

<section class="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title" class="section__title">{LANDING_COPY.howTitle}</h2>
    <p class="section__subtitle">{LANDING_COPY.howSubtitle}</p>

    <ol class="how-it-works__flow">
      {
        flow.map((item) => (
          <li class="how-it-works__item">
            <span class="how-it-works__icon" aria-hidden="true">
              {item.icon === 'search' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
                </svg>
              )}
              {item.icon === 'heart' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M12 21s-7-4.5-7-10a4.5 4.5 0 018.1-2.7A4.5 4.5 0 0119 11c0 5.5-7 10-7 10z"></path>
                </svg>
              )}
              {item.icon === 'phone' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
                  <rect x="6" y="3" width="12" height="18" rx="2"></rect>
                  <path d="M10 18h4" stroke-linecap="round"></path>
                </svg>
              )}
            </span>
            <div class="how-it-works__text">
              <span class="how-it-works__label">{item.title}</span>
              <p class="how-it-works__desc">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-it-works {
    padding-block: 1.1rem 0.85rem;
  }

  .how-it-works .section__title {
    margin-bottom: 0.25rem;
    text-wrap: balance;
  }

  .how-it-works .section__subtitle {
    margin-bottom: 0.9rem;
  }

  .how-it-works__flow {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 36rem;
  }

  .how-it-works__item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(115, 77, 87, 0.08);
  }

  .how-it-works__item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .how-it-works__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(235, 168, 168, 0.35);
    color: var(--malica-marrom-ameixa);
    flex-shrink: 0;
    margin-top: 0.05rem;
  }

  .how-it-works__text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .how-it-works__label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--malica-marrom-ameixa);
    line-height: 1.3;
  }

  .how-it-works__desc {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--malica-text-muted);
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .how-it-works {
      padding-block: 1.35rem 1rem;
    }

    .how-it-works .section__title,
    .how-it-works .section__subtitle {
      text-align: left;
    }

    .how-it-works__flow {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      max-width: none;
    }

    .how-it-works__item {
      flex-direction: column;
      gap: 0.55rem;
      padding: 0;
      border-bottom: 0;
      border-top: 0;
    }

    .how-it-works__icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .how-it-works__label {
      font-size: 1.05rem;
    }

    .how-it-works__desc {
      font-size: 0.875rem;
    }
  }
</style>
