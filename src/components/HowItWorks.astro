---
import { HOW_IT_WORKS } from '../config/site';
---

<section class="section how-it-works" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title" class="section__title">Como funciona</h2>
    <p class="section__subtitle">Três passos simples para começar a economizar.</p>

    <ol class="how-it-works__steps">
      {
        HOW_IT_WORKS.map((item) => (
          <li class="how-it-works__step">
            <span class="how-it-works__number" aria-hidden="true">
              {item.step}
            </span>
            <div class="how-it-works__content">
              <h3 class="how-it-works__title">{item.title}</h3>
              <p class="how-it-works__desc">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-it-works__steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .how-it-works__step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--malica-surface);
    border-radius: var(--malica-radius-md);
    padding: 1.25rem;
    box-shadow: var(--malica-shadow);
    border: 1px solid rgba(115, 77, 87, 0.06);
  }

  .how-it-works__number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--malica-rosa-antigo);
    color: var(--malica-marrom-ameixa);
    font-family: var(--malica-font-heading);
    font-weight: 600;
    font-size: 1rem;
  }

  .how-it-works__title {
    font-family: var(--malica-font-body);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .how-it-works__desc {
    font-size: 0.875rem;
    color: var(--malica-text-muted);
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .how-it-works__steps {
      flex-direction: row;
      gap: 1rem;
    }

    .how-it-works__step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
