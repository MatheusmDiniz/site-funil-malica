---
import { HOW_IT_WORKS } from '../config/site';
---

<section class="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title" class="section__title">Como funciona a Malica?</h2>
    <p class="section__subtitle">A gente procura, encontra e você recebe.</p>

    <ol class="how-it-works__steps">
      {
        HOW_IT_WORKS.map((item) => (
          <li class="how-it-works__step">
            <span class="how-it-works__number" aria-hidden="true">
              {item.step}
            </span>
            <div class="how-it-works__content">
              <h3 class="how-it-works__title">{item.title}</h3>
              <p class="how-it-works__desc">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-it-works {
    padding-block: 1.25rem 1rem;
  }

  .how-it-works .section__title {
    margin-bottom: 0.25rem;
  }

  .how-it-works .section__subtitle {
    margin-bottom: 0.875rem;
  }

  .how-it-works__steps {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .how-it-works__step {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    background: var(--malica-surface);
    border-radius: var(--malica-radius-sm);
    padding: 0.75rem 0.875rem;
    box-shadow: var(--malica-shadow);
    border: 1px solid rgba(115, 77, 87, 0.06);
  }

  .how-it-works__number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: var(--malica-rosa-antigo);
    color: var(--malica-marrom-ameixa);
    font-family: var(--malica-font-heading);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .how-it-works__title {
    font-family: var(--malica-font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.1rem;
  }

  .how-it-works__desc {
    font-size: 0.8125rem;
    color: var(--malica-text-muted);
    line-height: 1.4;
  }

  @media (min-width: 720px) {
    .how-it-works__steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.625rem;
    }
  }
</style>
