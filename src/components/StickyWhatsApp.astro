---
import { LANDING_COPY, SITE } from '../config/site';
---

<div class="sticky-cta" data-sticky-cta hidden>
  <a
    href={SITE.whatsappGroupUrl}
    class="sticky-cta__btn"
    data-track="whatsapp-group"
    data-cta-position="sticky"
    rel="noopener noreferrer"
    target="_blank"
  >
    <svg class="sticky-cta__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
    <span>{LANDING_COPY.ctaSticky}</span>
  </a>
</div>

<script>
  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const heroCta = document.querySelector('[data-hero-cta]');
  const finalCta = document.querySelector('[data-final-cta]');
  const footer = document.querySelector('[data-site-footer]');

  if (sticky) {
    const mq = window.matchMedia('(max-width: 767px)');
    let heroCtaVisible = true;
    let finalVisible = false;
    let footerVisible = false;

    const sync = () => {
      // Só mostra depois que o CTA do hero saiu da viewport;
      // some perto do FinalCta ou do footer.
      const show =
        mq.matches && !heroCtaVisible && !finalVisible && !footerVisible;
      if (show) {
        sticky.removeAttribute('hidden');
        document.body.classList.add('has-sticky-cta');
      } else {
        sticky.setAttribute('hidden', '');
        document.body.classList.remove('has-sticky-cta');
      }
    };

    mq.addEventListener('change', sync);

    if (typeof IntersectionObserver !== 'undefined') {
      if (heroCta) {
        const heroObserver = new IntersectionObserver(
          (entries) => {
            heroCtaVisible = entries.some((e) => e.isIntersecting);
            sync();
          },
          { threshold: 0 },
        );
        heroObserver.observe(heroCta);
      } else {
        // Sem hero CTA (ex.: /achadinhos) — libera o sticky no mobile
        heroCtaVisible = false;
      }

      if (finalCta) {
        const finalObserver = new IntersectionObserver(
          (entries) => {
            finalVisible = entries.some((e) => e.isIntersecting);
            sync();
          },
          { threshold: 0.15 },
        );
        finalObserver.observe(finalCta);
      }

      if (footer) {
        const footerObserver = new IntersectionObserver(
          (entries) => {
            footerVisible = entries.some((e) => e.isIntersecting);
            sync();
          },
          { threshold: 0.05 },
        );
        footerObserver.observe(footer);
      }
    } else {
      // Sem IO: sticky permanece oculto (degradação graciosa)
      heroCtaVisible = true;
    }

    sync();
  }
</script>

<style is:global>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-cta:not([hidden]) {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom, 0px));
      background: linear-gradient(
        180deg,
        rgba(255, 248, 245, 0) 0%,
        rgba(255, 248, 245, 0.92) 28%,
        var(--malica-creme) 100%
      );
      pointer-events: none;
    }

    .sticky-cta__btn {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      min-height: 3rem;
      padding: 0.7rem 1rem;
      border-radius: var(--malica-radius-md);
      background: var(--malica-cta);
      color: #fff !important;
      text-decoration: none !important;
      font-family: var(--malica-font-body);
      font-size: 0.9375rem;
      font-weight: 700;
      box-shadow: 0 6px 20px rgba(115, 77, 87, 0.18);
    }

    .sticky-cta__btn:hover {
      background: var(--malica-cta-hover);
    }

    .sticky-cta__btn:focus-visible {
      outline: 2px solid var(--malica-marrom-ameixa);
      outline-offset: 3px;
    }

    .sticky-cta__icon {
      width: 1.2rem;
      height: 1.2rem;
      flex-shrink: 0;
    }

    body.has-sticky-cta {
      padding-bottom: calc(var(--malica-sticky-cta-height) + env(safe-area-inset-bottom, 0px));
    }

    body.has-sticky-cta .footer {
      padding-bottom: 1rem;
    }
  }
</style>
