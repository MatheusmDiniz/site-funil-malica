---
import { LANDING_COPY, STORES } from '../config/site';
---

<section class="stores" aria-labelledby="stores-title">
  <div class="container stores__inner">
    <h2 id="stores-title" class="stores__title">
      {LANDING_COPY.storesTitle}
    </h2>

    <ul class="stores__list" aria-label="Lojas e marketplaces">
      {
        STORES.map((store) => (
          <li class="stores__item">
            <img
              class="stores__logo"
              src={store.logo}
              alt={store.name}
              width="120"
              height="32"
              loading="lazy"
              decoding="async"
            />
            <span class="sr-only">{store.name}</span>
          </li>
        ))
      }
    </ul>

    <p class="stores__disclaimer">
      Marcas citadas são independentes e não patrocinam a Malica.
    </p>
  </div>
</section>

<style>
  .stores {
    padding-block: 0.75rem 1rem;
  }

  .stores__inner {
    text-align: center;
  }

  .stores__title {
    font-family: var(--malica-font-heading);
    font-size: clamp(1.05rem, 3.5vw, 1.25rem);
    font-weight: 600;
    color: var(--malica-marrom-ameixa);
    margin: 0 0 0.85rem;
    text-wrap: balance;
    line-height: 1.3;
  }

  .stores__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 0 0 0.65rem;
    padding: 0;
    list-style: none;
  }

  .stores__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
  }

  .stores__logo {
    height: 1.75rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    opacity: 0.92;
  }

  .stores__disclaimer {
    font-size: 0.6875rem;
    color: var(--malica-text-muted);
    max-width: 22rem;
    margin: 0 auto;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .stores {
      padding-block: 0.9rem 1.1rem;
    }

    .stores__title {
      font-size: 1.3rem;
      margin-bottom: 1rem;
    }

    .stores__list {
      gap: 1rem 2.25rem;
    }

    .stores__logo {
      height: 2rem;
      max-width: 8.5rem;
    }
  }
</style>
