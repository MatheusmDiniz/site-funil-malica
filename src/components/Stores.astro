---
import { STORES } from '../config/site';
---

<section class="section section--alt stores" aria-labelledby="stores-title">
  <div class="container stores__inner">
    <h2 id="stores-title" class="section__title">Onde buscamos ofertas</h2>
    <p class="section__subtitle">
      Garimpamos promoções em grandes lojas e marketplaces confiáveis.
    </p>

    <ul class="stores__list" aria-label="Lojas e marketplaces">
      {
        STORES.map((store) => (
          <li class="stores__item">
            <span class="stores__name">{store}</span>
          </li>
        ))
      }
    </ul>

    <p class="stores__disclaimer">
      Marcas citadas são independentes e não patrocinam a Malica.
    </p>
  </div>
</section>

<style>
  .stores__inner {
    text-align: center;
  }

  .stores__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .stores__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stores__name {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    background: var(--malica-surface);
    border-radius: var(--malica-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--malica-text-muted);
    border: 1px solid rgba(115, 77, 87, 0.08);
    letter-spacing: 0.02em;
  }

  .stores__disclaimer {
    font-size: 0.75rem;
    color: var(--malica-text-muted);
    max-width: 24rem;
    margin-inline: auto;
    line-height: 1.5;
  }
</style>
