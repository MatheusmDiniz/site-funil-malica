---
import { LANDING_COPY, TRUST_POINTS } from '../config/site';

const icons: Record<string, string> = {
  gift: 'M20 12v8a1 1 0 01-1 1H5a1 1 0 01-1-1v-8m16 0H4m16 0l-2-4H6L4 12m8-9v5m0 0H8.5A2.5 2.5 0 118.5 5c1 0 1.5.5 3.5 3zm0 0h3.5A2.5 2.5 0 1015.5 5c-1 0-1.5.5-3.5 3z',
  'baby-bottle':
    'M8 3h8v2a4 4 0 01-4 4 4 4 0 01-4-4V3zm4 8a6 6 0 006-6V2a1 1 0 00-1-1H7a1 1 0 00-1 1v3a6 6 0 006 6zm-2 2v5a2 2 0 104 0v-5',
  quiet:
    'M12 3a9 9 0 100 18 9 9 0 000-18zm-1 5h2v5h-2V8zm0 7h2v2h-2v-2z',
  search:
    'M11 4a7 7 0 015.6 11.2l3.1 3.1-1.4 1.4-3.1-3.1A7 7 0 1111 4zm0 2a5 5 0 100 10 5 5 0 000-10z',
};
---

<section class="trust" aria-labelledby="trust-title">
  <div class="container">
    <h2 id="trust-title" class="section__title">{LANDING_COPY.trustTitle}</h2>

    <ul class="trust__list">
      {
        TRUST_POINTS.map((point) => (
          <li class="trust__item">
            <span class="trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d={icons[point.icon] ?? icons.search}></path>
              </svg>
            </span>
            <div>
              <h3 class="trust__item-title">{point.title}</h3>
              <p class="trust__item-desc">{point.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: 0.85rem 0.65rem;
  }

  .trust .section__title {
    margin-bottom: 0.65rem;
    text-wrap: balance;
    font-size: clamp(1.15rem, 3.8vw, 1.4rem);
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .trust__item {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(115, 77, 87, 0.08);
  }

  .trust__item:last-child {
    border-bottom: 0;
  }

  .trust__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(244, 215, 197, 0.65);
    color: var(--malica-marrom-ameixa);
    flex-shrink: 0;
  }

  .trust__item-title {
    font-family: var(--malica-font-body);
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.1rem;
    color: var(--malica-marrom-ameixa);
  }

  .trust__item-desc {
    margin: 0;
    font-size: 0.75rem;
    color: var(--malica-text-muted);
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .trust {
      padding-block: 1.1rem 0.85rem;
    }

    .trust .section__title {
      text-align: left;
      font-size: 1.45rem;
    }

    .trust__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 1.75rem;
      max-width: none;
    }

    .trust__item {
      padding: 0.55rem 0;
      background: transparent;
      box-shadow: none;
      border-radius: 0;
      border-bottom: 0;
    }

    .trust__icon {
      background: transparent;
      width: 1.5rem;
      height: 1.5rem;
      color: var(--malica-verde-salvia);
    }
  }
</style>
