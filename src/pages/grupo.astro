---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { GRUPO_COPY, SITE, SOCIAL_PROOF_STATS } from '../config/site';

const membersStat = SOCIAL_PROOF_STATS[0]?.value;
const spotsLeft = Math.max(GRUPO_COPY.groupCapacity - GRUPO_COPY.groupMembers, 0);
const spotsPercent = Math.min(
  Math.round((GRUPO_COPY.groupMembers / GRUPO_COPY.groupCapacity) * 100),
  100,
);
const currentYear = new Date().getFullYear();
---

<BaseLayout
  title={GRUPO_COPY.seoTitle}
  description={GRUPO_COPY.seoDescription}
  canonicalPath="/grupo"
  showOffersBanner={false}
  noindex
>
  <main id="conteudo-principal" class="grupo">
    <div class="grupo__card">
      <img
        src="/images/malica-logo.png"
        alt="Malica"
        width="120"
        height="34"
        class="grupo__logo"
      />

      <p class="grupo__badge">
        <span class="grupo__badge-dot" aria-hidden="true"></span>
        {GRUPO_COPY.badge}
      </p>

      <h1 class="grupo__headline">{GRUPO_COPY.headline}</h1>
      <p class="grupo__subtitle">{GRUPO_COPY.subtitle}</p>

      <img
        src="/images/malica-mascote.png"
        alt=""
        width="120"
        height="120"
        class="grupo__mascote"
      />

      {
        membersStat && (
          <p class="grupo__proof">
            Já somos <strong>{membersStat}</strong> {GRUPO_COPY.socialProofSuffix}
          </p>
        )
      }

      <div class="grupo__cta">
        <WhatsAppCta label={GRUPO_COPY.cta} ctaPosition="grupo" />
        <p class="grupo__cta-fine">{GRUPO_COPY.ctaFine}</p>
      </div>

      {
        GRUPO_COPY.showCountdown && (
          <div class="grupo__countdown">
            <span class="grupo__countdown-label">{GRUPO_COPY.countdownLabel}</span>
            <span class="grupo__countdown-time" role="timer" data-grupo-countdown>
              --:--:--
            </span>
          </div>
        )
      }

      <ul class="grupo__checklist">
        {
          GRUPO_COPY.checklist.map((item) => (
            <li>
              <span class="grupo__check-emoji" aria-hidden="true">
                {item.emoji}
              </span>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>

      {
        GRUPO_COPY.showSpots && (
          <div class="grupo__spots">
            <p class="grupo__spots-text">
              Restam <strong>{spotsLeft}</strong> vagas neste grupo
            </p>
            <div
              class="grupo__spots-bar"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax={GRUPO_COPY.groupCapacity}
              aria-valuenow={GRUPO_COPY.groupMembers}
              aria-label="Vagas preenchidas no grupo"
            >
              <span style={`width: ${spotsPercent}%`} />
            </div>
          </div>
        )
      }

      <section class="grupo__trust" aria-labelledby="grupo-trust-title">
        <h2 id="grupo-trust-title">{GRUPO_COPY.trustTitle}</h2>
        <p>{GRUPO_COPY.trustText}</p>
      </section>

      <div class="grupo__cta">
        <WhatsAppCta label={GRUPO_COPY.cta} ctaPosition="grupo" />
      </div>
    </div>

    <footer class="grupo__footer">
      <p>
        Alguns links divulgados pela Malica podem ser links de afiliados. Ao comprar
        através deles, podemos receber uma comissão, sem nenhum custo adicional para
        você. Preços e promoções podem mudar sem aviso prévio.
      </p>
      <p>
        Amazon, Shopee e Mercado Livre não patrocinam nem têm vínculo com a Malica.
      </p>
      <nav aria-label="Links legais">
        <a href="/politica-de-privacidade">Política de Privacidade</a>
        <span aria-hidden="true">·</span>
        <a href="/termos-de-uso">Termos de Uso</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${SITE.contactEmail}`}>Contato</a>
      </nav>
      <p>© {currentYear} Malica</p>
    </footer>
  </main>
</BaseLayout>

<script>
  const SECONDS_PER_DAY = 86400;
  const formatter = new Intl.DateTimeFormat('pt-BR', {
    timeZone: 'America/Sao_Paulo',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  });

  function secondsUntilMidnightBrasilia(): number {
    const parts = formatter.formatToParts(new Date());
    const get = (type: string) =>
      Number(parts.find((part) => part.type === type)?.value ?? 0);
    const elapsed = get('hour') * 3600 + get('minute') * 60 + get('second');
    return SECONDS_PER_DAY - elapsed;
  }

  function pad(value: number): string {
    return String(value).padStart(2, '0');
  }

  const el = document.querySelector<HTMLElement>('[data-grupo-countdown]');

  if (el) {
    const render = () => {
      const remaining = secondsUntilMidnightBrasilia();
      const h = Math.floor(remaining / 3600);
      const m = Math.floor((remaining % 3600) / 60);
      const s = remaining % 60;
      el.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
    };
    render();
    window.setInterval(render, 1000);
  }
</script>

<style>
  .grupo {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem var(--malica-container-padding) 1.5rem;
    background:
      radial-gradient(circle at 50% 0%, rgba(235, 168, 168, 0.35), transparent 60%),
      var(--malica-creme);
  }

  .grupo__card {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    padding: 1.5rem 1.125rem 1.375rem;
    border-radius: var(--malica-radius-lg);
    background: var(--malica-surface);
    box-shadow: 0 10px 36px rgba(115, 77, 87, 0.12);
    text-align: center;
  }

  .grupo__logo {
    height: 2rem;
    width: auto;
  }

  .grupo__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.875rem;
    border-radius: 999px;
    background: var(--malica-marrom-ameixa);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .grupo__badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--malica-rosa-antigo);
    flex-shrink: 0;
  }

  .grupo__headline {
    font-size: clamp(1.6rem, 7vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--malica-marrom-ameixa);
  }

  .grupo__subtitle {
    font-size: 0.975rem;
    line-height: 1.45;
    color: var(--malica-text-muted);
  }

  .grupo__mascote {
    width: 5rem;
    height: auto;
  }

  .grupo__proof {
    padding: 0.5rem 0.875rem;
    border-radius: var(--malica-radius-sm);
    background: var(--malica-bege);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .grupo__proof strong {
    font-weight: 800;
  }

  .grupo__checklist {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }

  .grupo__checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--malica-radius-sm);
    background: var(--malica-creme);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .grupo__check-emoji {
    flex-shrink: 0;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .grupo__cta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .grupo__cta :global(.whatsapp-cta) {
    min-height: 3.5rem;
    padding-inline: 1rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 22px rgba(139, 170, 157, 0.45);
  }

  .grupo__cta-fine {
    font-size: 0.75rem;
    color: var(--malica-text-muted);
  }

  .grupo__countdown {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.625rem;
    border-radius: var(--malica-radius-sm);
    border: 1px dashed var(--malica-rosa-antigo);
  }

  .grupo__countdown-label {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .grupo__countdown-time {
    font-family: var(--malica-font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: #b35a5a;
  }

  .grupo__spots {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .grupo__spots-text {
    font-size: 0.875rem;
  }

  .grupo__spots-text strong {
    color: #b35a5a;
  }

  .grupo__spots-bar {
    width: 100%;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--malica-creme-escuro);
    overflow: hidden;
  }

  .grupo__spots-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--malica-rosa-antigo), #d98a8a);
  }

  .grupo__trust {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.875rem 1rem;
    border-radius: var(--malica-radius-md);
    background: var(--malica-creme-escuro);
  }

  .grupo__trust h2 {
    font-size: 1.0625rem;
  }

  .grupo__trust p {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--malica-text-muted);
  }

  .grupo__footer {
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--malica-text-muted);
  }

  .grupo__footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.4rem;
    font-size: 0.8125rem;
  }

  .grupo__footer a {
    text-decoration: none;
  }

  .grupo__footer a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .grupo__badge-dot {
      animation: grupoBlink 1.4s ease-in-out infinite;
    }

    .grupo__cta :global(.whatsapp-cta) {
      animation: grupoPulse 1.8s ease-in-out infinite;
    }

    .grupo__cta :global(.whatsapp-cta:hover) {
      animation-play-state: paused;
    }

    @keyframes grupoPulse {
      0%,
      100% {
        transform: scale(1);
        box-shadow: 0 8px 22px rgba(139, 170, 157, 0.45);
      }

      50% {
        transform: scale(1.04);
        box-shadow: 0 10px 30px rgba(139, 170, 157, 0.7);
      }
    }

    @keyframes grupoBlink {
      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.3;
      }
    }
  }
</style>
